# ============================================
# 🦉 NightOwl Environment Configuration
# Copy this to .env and fill in your values
# ============================================

# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# AI Providers
# You can use any combination of these providers

# Anthropic (Claude) - https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (Whisper for voice) - https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Zhipu AI (GLM models) - https://open.bigmodel.cn
ZHIPU_API_KEY=your_zhipu_api_key_here

# Moonshot AI (Kimi models) - https://platform.moonshot.cn
MOONSHOT_API_KEY=your_moonshot_api_key_here

# GitLab Configuration
GITLAB_TOKEN=your_gitlab_token_here
GITLAB_NAMESPACE=your_gitlab_username_or_group
GITLAB_URL=https://gitlab.com

# Note: GitHub repos can be edited by agents, but NightOwl deploys to GitLab only

# Server Configuration
PORT=4000
NODE_ENV=development

# OpenHands Configuration
OPENHANDS_URL=http://localhost:3000
OPENHANDS_API_KEY=optional_api_key

# Dashboard Configuration
DASHBOARD_PORT=4000
DASHBOARD_PASSWORD=nightowl_secure_password

# EC2 Configuration (for CI/CD)
EC2_HOST=your_ec2_ip_here
EC2_USER=ubuntu

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Feature Flags
ENABLE_VOICE=true
ENABLE_OPENHANDS=true
ENABLE_DASHBOARD=true

# Default AI Provider (anthropic|zhipu|moonshot)
DEFAULT_AI_PROVIDER=anthropic
