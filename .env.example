# =============================================================================
# 🦉 NIGENTS (Night Agents) - Environment Configuration
# Copy this file to .env and fill in your actual values
# =============================================================================

# =============================================================================
# REQUIRED: Telegram Bot Configuration
# =============================================================================
# Get your bot token from @BotFather on Telegram:
# 1. Open Telegram, search for "@BotFather"
# 2. Send /newbot command
# 3. Follow prompts to create your bot
# 4. Copy the token (looks like: 123456789:ABCdefGHIjklMNOpqrSTUvwxyz)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get your chat ID from @userinfobot on Telegram:
# 1. Open Telegram, search for "@userinfobot"
# 2. Send any message to it
# 3. It will reply with your user info including the ID (e.g., 123456789)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Public URL of the web dashboard (no trailing slash) — used for /meeting links in Telegram
# Example: https://your-domain.com:4000
PUBLIC_DASHBOARD_URL=http://localhost:4000

# Shared secret so the Telegram bot can create meeting sessions on the dashboard over HTTP
# (required if bot and dashboard run on different hosts). Generate: openssl rand -hex 32
# MEETING_INTERNAL_SECRET=

# Optional: Jitsi-compatible domain for human voice rooms (default: meet.jit.si)
# JITSI_DOMAIN=meet.jit.si

# =============================================================================
# REQUIRED: AI Provider API Keys (Add at least ONE provider)
# =============================================================================

# Option 1: Anthropic Claude (Recommended for best code quality)
# Get from: https://console.anthropic.com/
# Supports: Claude 3.5 Sonnet, Claude 3 Opus
# Best for: Complex reasoning, code generation, debugging
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 2: Zhipu AI (GLM-4 models - Cost effective)
# Get from: https://open.bigmodel.cn/
# Supports: GLM-4, GLM-4-Flash
# Best for: Budget-conscious, fast responses
ZHIPU_API_KEY=your_zhipu_api_key_here

# Option 3: Moonshot AI (Kimi models - Great for Chinese + English)
# Get from: https://platform.moonshot.cn/
# Supports: Kimi K2, Kimi K1.5
# Best for: Multilingual code, long context
MOONSHOT_API_KEY=your_moonshot_api_key_here

# Option 4: DeepSeek (High quality, low cost)
# Get from: https://platform.deepseek.com/
# Supports: DeepSeek Coder, DeepSeek Chat
# Best for: Code-specific tasks
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Default AI Provider (used when no specific provider is selected)
# Options: anthropic | zhipu | moonshot | deepseek
DEFAULT_AI_PROVIDER=anthropic

# =============================================================================
# REQUIRED: GitLab Integration
# =============================================================================
# GitLab Personal Access Token (NOT Project Access Token!)
# 
# Why Personal Access Token?
# - Can access ALL repos you have permission to
# - Required for repo listing API
# - Works across multiple projects
#
# Get from: https://gitlab.com/-/profile/personal_access_tokens
# 1. Click your avatar (top right) → Edit Profile
# 2. Left sidebar → Access Tokens
# 3. Click "Add new token"
# 4. Name: Nigents
# 5. Expiration: 1 year from now
# 6. Scopes: Check ALL of these:
#    - api (Full API access)
#    - read_repository
#    - write_repository
#    - read_user
# 7. Click "Create" and COPY the token immediately
# 
# Token format: glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_TOKEN=glpat-your_gitlab_token_here

# Your GitLab namespace (username or group name)
# Examples:
#   - Personal: "john-doe"
#   - Group: "bonyad-tech"
#   - Sub-group: "bonyad-tech/team-alpha"
GITLAB_NAMESPACE=bonyad-tech

# GitLab instance URL (change if self-hosted)
# Self-hosted example: https://gitlab.yourcompany.com
GITLAB_URL=https://gitlab.com

# =============================================================================
# OPTIONAL: OpenAI (Required only for voice processing feature)
# =============================================================================
# Get from: https://platform.openai.com/
# Used for: Speech-to-text (Whisper) for voice commands
# If not provided, voice commands will be disabled
OPENAI_API_KEY=sk-your-openai-key-here

# =============================================================================
# Server Configuration
# =============================================================================
# Port for the dashboard server (default: 4000)
PORT=4000
DASHBOARD_PORT=4000

# Node environment (development | production)
NODE_ENV=production

# =============================================================================
# Dashboard Configuration
# =============================================================================
# Password to access the web dashboard
# Change this to a secure password!
DASHBOARD_PASSWORD=change_this_to_secure_password

# Full URL of your dashboard (update after HTTPS setup)
# Local: http://localhost:4000
# Production: https://nigents.com
DASHBOARD_URL=https://nigents.com

# =============================================================================
# OpenHands Configuration (Code Sandbox)
# =============================================================================
# URL where OpenHands is running
# Default: http://localhost:3000 (if running locally)
OPENHANDS_URL=http://localhost:3000

# Optional API key for OpenHands (if required)
OPENHANDS_API_KEY=

# =============================================================================
# EC2 Configuration (for CI/CD deployment)
# =============================================================================
# Your EC2 instance public IP address
# Example: 3.91.48.123
EC2_HOST=your_ec2_ip_here

# SSH username for EC2 (usually 'ubuntu' for Ubuntu AMIs)
EC2_USER=ubuntu

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: debug | info | warn | error
LOG_LEVEL=info

# Directory for log files
LOG_DIR=./logs

# =============================================================================
# Database Configuration (MySQL)
# =============================================================================

# MySQL Database Settings
# For local development, install MySQL or use Docker:
# docker run -d --name mysql -e MYSQL_ROOT_PASSWORD=root -e MYSQL_DATABASE=nigents -e MYSQL_USER=nigents -e MYSQL_PASSWORD=nigents_password -p 3306:3306 mysql:8
DB_HOST=localhost
DB_PORT=3306
DB_USER=nigents
DB_PASSWORD=nigents_password
DB_NAME=nigents

# Legacy: JSON data directory (used for migration only)
DATA_DIR=./data

# =============================================================================
# Feature Flags (Enable/Disable Features)
# =============================================================================

# Enable voice command processing via Telegram
# Requires: OPENAI_API_KEY to be set
ENABLE_VOICE=true

# Enable OpenHands code sandbox integration
ENABLE_OPENHANDS=true

# Enable web dashboard
ENABLE_DASHBOARD=true

# =============================================================================
# OPTIONAL: External Integrations
# =============================================================================

# Slack webhook for notifications
# Get from: Slack App → Incoming Webhooks
# SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# Discord webhook for notifications
# Get from: Server Settings → Integrations → Webhooks
# DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# =============================================================================
# SECURITY WARNING
# =============================================================================
# NEVER commit this file with real values to git!
# The .env file is in .gitignore for security.
# Always keep your API keys private and rotate them regularly.
# =============================================================================
