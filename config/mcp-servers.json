        "GRAFANA_API_KEY": "${GRAFANA_API_KEY}"
      },
      "description": "Grafana dashboards"
    },
    "elasticsearch": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-elasticsearch"],
