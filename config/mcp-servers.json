{
  "servers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/workspace"],
      "enabled": true,
      "description": "File system operations - read, write, search files",
      "critical": true
    },
    "git": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-git", "/workspace"],
      "enabled": true,
      "description": "Git operations - commit, branch, diff, status",
      "critical": true
    },
    "gitlab": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-gitlab"],
      "enabled": true,
      "env": {
        "GITLAB_TOKEN": "${GITLAB_TOKEN}",
        "GITLAB_URL": "${GITLAB_URL}"
      },
      "description": "GitLab API - repos, MRs, issues",
      "critical": true
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "description": "GitHub API - repos, PRs, issues",
      "critical": false
    },
    "fetch": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"],
      "enabled": true,
      "description": "HTTP requests - fetch web content, APIs",
      "critical": false
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true,
      "description": "Advanced reasoning and problem-solving",
      "critical": false
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "enabled": true,
      "description": "Persistent memory across conversations",
      "critical": false
    },
    "postgresql": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "${DATABASE_URL}"],
      "enabled": false,
      "env": {
        "DATABASE_URL": "postgresql://user:pass@localhost:5432/nightowl"
      },
      "description": "PostgreSQL database queries and schema",
      "critical": false
    },
    "sqlite": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sqlite", "/workspace/data/nightowl.db"],
      "enabled": false,
      "description": "SQLite database for local task storage",
      "critical": false
    },
    "puppeteer": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"],
      "enabled": false,
      "description": "Browser automation - screenshots, navigation",
      "critical": false
    },
    "brave-search": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "enabled": false,
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "description": "Web search via Brave Search API",
      "critical": false
    },
    "redis": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-redis"],
      "enabled": false,
      "env": {
        "REDIS_URL": "redis://localhost:6379"
      },
      "description": "Redis cache and pub/sub",
      "critical": false
    },
    "docker": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-docker"],
      "enabled": false,
      "description": "Docker container management",
      "critical": false
    },
    "smart-code-search": {
      "type": "stdio",
      "command": "node",
      "args": ["/workspace/mcp-servers/smart-code-search/dist/index.js"],
      "enabled": false,
      "description": "Semantic code search using embeddings - REQUIRES BUILD",
      "critical": false
    },
    "arabic-rtl-auditor": {
      "type": "stdio",
      "command": "node",
      "args": ["/workspace/mcp-servers/arabic-rtl-auditor/dist/index.js"],
      "enabled": false,
      "description": "Arabic RTL compliance auditing - REQUIRES BUILD",
      "critical": false
    },
    "task-splitter": {
      "type": "stdio",
      "command": "node",
      "args": ["/workspace/mcp-servers/task-splitter/dist/index.js"],
      "enabled": false,
      "description": "Intelligent task splitting - REQUIRES BUILD",
      "critical": false
    }
  },
  "agentTools": {
    "orchestrator": ["memory", "sequential-thinking", "fetch", "gitlab", "github"],
    "planner": ["filesystem", "git", "gitlab", "github", "fetch", "sequential-thinking", "memory"],
    "backend-dev": ["filesystem", "git", "gitlab", "github", "fetch", "memory"],
    "frontend-dev": ["filesystem", "git", "gitlab", "github", "fetch"],
    "qa-tester": ["filesystem", "git", "gitlab", "github", "fetch"],
    "code-reviewer": ["filesystem", "git", "gitlab", "github", "sequential-thinking"],
    "reporter": ["fetch", "memory"],
    "devops": ["filesystem", "git", "gitlab", "github", "fetch", "memory", "docker"],
    "security": ["filesystem", "git", "gitlab", "github", "fetch", "sequential-thinking"],
    "architect": ["filesystem", "git", "gitlab", "github", "fetch", "sequential-thinking", "memory"]
  },
  "settings": {
    "connectionTimeout": 30000,
    "retryAttempts": 2,
    "fallbackToDirectAI": true
  }
}
