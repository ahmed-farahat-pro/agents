        "MINIO_SECRET_KEY": "${MINIO_SECRET_KEY}"
      },
      "description": "MinIO S3-compatible storage"
    },
    "cloudflare": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-cloudflare"],
      "enabled": false,
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}"
      },
      "description": "Cloudflare DNS and Workers"
    },
    "vercel": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-vercel"],
      "enabled": false,
      "env": {
        "VERCEL_TOKEN": "${VERCEL_TOKEN}"
      },
      "description": "Vercel deployments"
    },
    "netlify": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-netlify"],
      "enabled": false,
      "env": {
        "NETLIFY_AUTH_TOKEN": "${NETLIFY_AUTH_TOKEN}"
      },
      "description": "Netlify deployments"
    },
    "heroku": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-heroku"],
      "enabled": false,
      "env": {
        "HEROKU_API_KEY": "${HEROKU_API_KEY}"
      },
      "description": "Heroku deployments"
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "description": "GitHub API - for editing GitHub repos (agents can edit both GitLab and GitHub)"
    }
  },
  "agentTools": {
    "orchestrator": ["memory", "sequential-thinking", "fetch", "gitlab", "obsidian", "redis"],
    "planner": ["filesystem", "git", "gitlab", "fetch", "sequential-thinking", "brave-search", "obsidian", "openapi"],
    "backend-dev": ["filesystem", "git", "gitlab", "postgresql", "sqlite", "redis", "mongodb", "fetch", "docker", "terraform", "ansible", "openapi", "kafka", "rabbitmq", "mqtt", "nats"],
    "frontend-dev": ["filesystem", "git", "gitlab", "fetch", "puppeteer", "figma", "miro", "vercel", "netlify", "cloudflare"],
    "qa-tester": ["filesystem", "git", "gitlab", "postgresql", "sqlite", "puppeteer", "fetch", "docker", "prometheus", "grafana", "selenium"],
    "code-reviewer": ["filesystem", "git", "gitlab", "github", "sequential-thinking", "obsidian", "openapi"],
    "reporter": ["slack", "discord", "filesystem", "fetch", "notion", "jira", "confluence", "google-calendar"]
  }
}
